# Every version the test environment depends on, in one place.
#
# Sourced by test-env.sh and install-tools.sh, and read by tests/test_test_env.py, which
# holds the configs in kind/ and k3d/ to these values. Change a version here and nowhere
# else. Images are pinned by digest and manifests by checksum, so "the same version" means
# the same bytes on every machine and in CI.

# -- tools ------------------------------------------------------------------------------
KIND_VERSION=v0.33.0
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.37.0
CILIUM_CLI_VERSION=v0.20.1

# -- Kubernetes, the same minor on both tools --------------------------------------------
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
K3S_IMAGE=rancher/k3s:v1.37.0-k3s1@sha256:d33b1973401a60410681d66c007f5c3a51d565a7c03608904764aef3321fee4d

# -- CNIs other than the tool's own ------------------------------------------------------
CALICO_VERSION=v3.32.2
CALICO_MANIFEST_SHA256=a8c828a06a87c629a282ebbc424895b77f3a030251993e41ea400a743675bb02
CILIUM_VERSION=1.20.2
FLANNEL_VERSION=v0.28.9
FLANNEL_MANIFEST_SHA256=1c06a15a771009c263bdb1f51c928af46f7606fe969f3963652167938d536aaa
# flannel hands pod networking to the `bridge` CNI plugin, which kind's node image does not
# ship. kind-flannel adds that one binary from the reference plugins; checksums per node
# architecture.
CNI_PLUGINS_VERSION=v1.9.1
CNI_PLUGINS_SHA256_AMD64=b98f74a0f8522f0a83867178729c1aa70f2158f90c45a2ca8fa791db1c76b303
CNI_PLUGINS_SHA256_ARM64=56171987d3947707c3563db2f4001bccaf50fd63468611b9f3cbecb1375ee7ec

# -- the image the environment check runs ------------------------------------------------
CHECK_IMAGE=busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
